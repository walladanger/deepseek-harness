{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Web Tray",
  "version": "0.1.0",
  "identifier": "ai.deepseek.dsh.windows-tray",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis"],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
