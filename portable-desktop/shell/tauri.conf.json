{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portable Web Shell",
  "version": "0.1.0",
  "identifier": "com.walladanger.portable-web-shell",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
